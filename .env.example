# Entorno
APP_ENV=dev

# LLM — modo seguro por defecto: sin llamadas reales.
USE_REAL_GEMINI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# QuickBooks Online — modo fake por defecto.
USE_REAL_QBO=0
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox

# Persistencia
DATABASE_PATH=data/receiptflow.sqlite
TRACES_PATH=artifacts/traces.jsonl

# Límites del agente
AGENT_MAX_STEPS=8
AGENT_MAX_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# Costos (valores educativos, revisar antes de usar)
INPUT_USD_PER_MILLION=0.30
OUTPUT_USD_PER_MILLION=2.50
